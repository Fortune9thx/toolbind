# Defaults to the live studio-dev deployment (see README.md "Live
# deployment"). Override only if you've deployed your own instance.
NEXT_PUBLIC_TOOLBIND_CONTRACT=0x70Bb4A318Bb143167e065483A39e581CCB7fe868

NEXT_PUBLIC_GENLAYER_RPC=https://studio-dev.genlayer.com/api
NEXT_PUBLIC_CHAIN_ID=61997

# Optional -- get a free project id at https://cloud.walletconnect.com if you
# want the WalletConnect QR flow to work. Browser-extension wallets (MetaMask,
# Rabby, etc.) connect fine without it.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
